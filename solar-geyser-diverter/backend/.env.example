# Copy to .env and fill in real values before running. Never commit .env.

# Signs user session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret the manufacturing/commissioning step uses to register new
# devices (Specification §22: installer-only). Not end-user-facing. Generate
# the same way as JWT_SECRET.
MANUFACTURING_KEY=change-me-to-a-long-random-string

# Optional — defaults shown.
PORT=8787
DB_PATH=./data.sqlite
